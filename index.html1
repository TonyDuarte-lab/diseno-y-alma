<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Diseño & Alma | Frentes de Parrilla Premium</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#060402;
    --bg-2:#0f0906;
    --fire-1:#ffd35c;
    --fire-2:#ff7a1a;
    --fire-3:#e6350f;
    --fire-4:#7a0f0a;
    --ring-pink:#e0359c;
    --ring-purple:#8a2be2;
    --text:#fff8ec;
    --text-dim:#e2d5c2;
    --steel:#c3c8ce;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;overflow-x:hidden;width:100%;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Work Sans',sans-serif;
    overflow-x:hidden;
  }
  ::selection{background:var(--fire-2);color:#0a0705;}

  h1,h2,h3,.display{
    font-family:'Anton',sans-serif;
    font-weight:400;
    letter-spacing:0.02em;
    text-transform:uppercase;
  }
  h2{text-shadow:0 2px 24px rgba(0,0,0,0.5);}

  a{color:inherit;text-decoration:none;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  /* ---------- NAV ---------- */
  /* ---------- TICKER DE OFERTAS ---------- */
  .ticker{
    position:fixed;top:0;left:0;right:0;z-index:110;
    height:34px;
    display:flex;align-items:center;
    overflow:hidden;
    background:linear-gradient(120deg, var(--fire-3), var(--fire-2), var(--fire-1), var(--fire-2), var(--fire-3));
    background-size:300% 100%;
    animation:tickerGradient 8s ease infinite;
    border-bottom:1px solid rgba(0,0,0,0.25);
  }
  @keyframes tickerGradient{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }
  .ticker-track{
    display:flex;
    white-space:nowrap;
    animation:tickerScroll 28s linear infinite;
  }
  .ticker-track span{
    display:inline-flex;align-items:center;
    padding:0 28px;
    font-size:0.78rem;
    font-weight:600;
    letter-spacing:0.03em;
    color:#1a0a02;
    text-transform:uppercase;
  }
  @keyframes tickerScroll{
    0%{transform:translateX(0);}
    100%{transform:translateX(-50%);}
  }
  @media (prefers-reduced-motion: reduce){
    .ticker-track{animation:none;}
  }

  nav{
    position:fixed;top:34px;left:0;right:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:20px 6vw;
    background:linear-gradient(to bottom, rgba(10,7,5,0.85), transparent);
    backdrop-filter:blur(2px);
  }
  .nav-brand{display:flex;align-items:center;gap:12px;}
  .nav-logo{
    width:38px;height:38px;
    border-radius:50%;
    filter:drop-shadow(0 0 10px rgba(255,122,26,0.55));
  }
  .nav-mark{
    display:flex;
    align-items:center;
    gap:12px;
    font-family:'Anton',sans-serif;
    font-size:1.1rem;
    letter-spacing:0.08em;
  }
  .nav-mark span{color:var(--fire-2);}
  .nav-links{display:flex;gap:32px;font-size:0.85rem;letter-spacing:0.08em;text-transform:uppercase;}
  .nav-links a{opacity:0.8;transition:opacity 0.25s, color 0.25s;position:relative;}
  .nav-links a:hover{opacity:1;color:var(--fire-2);}
  .nav-cta{
    display:none;
  }
  @media(min-width:720px){
    .nav-cta{
      display:inline-block;
      padding:10px 20px;
      border:1px solid var(--fire-2);
      border-radius:2px;
      font-size:0.78rem;
      letter-spacing:0.08em;
      text-transform:uppercase;
      transition:background 0.25s, color 0.25s;
    }
    .nav-cta:hover{background:var(--fire-2);color:#0a0705;}
  }
  @media(max-width:719px){ .nav-links{display:none;} }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:100svh;
    padding:150px 0 60px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    overflow:hidden;
  }
  #ember-canvas{
    position:absolute;inset:0;width:100%;height:100%;
    z-index:1;
    pointer-events:none;
  }
  .logo-bg{
    position:absolute;
    top:50%;left:50%;
    width:min(90vw, 900px);
    height:min(90vw, 900px);
    background-size:contain;
    background-repeat:no-repeat;
    background-position:center;
    transform:translate(-50%,-50%) scale(1);
    opacity:0.16;
    filter:blur(6px) saturate(1.2);
    z-index:0;
    animation:logoDrift 16s ease-in-out infinite;
    mix-blend-mode:screen;
  }
  @keyframes logoDrift{
    0%{ transform:translate(-50%,-50%) scale(1) rotate(0deg); opacity:0.14; }
    50%{ transform:translate(-49%,-51%) scale(1.06) rotate(1.5deg); opacity:0.22; }
    100%{ transform:translate(-50%,-50%) scale(1) rotate(0deg); opacity:0.14; }
  }
  .fire-glow{
    position:absolute;
    bottom:-10%;
    left:50%;
    transform:translateX(-50%);
    width:140vw;
    height:70vh;
    z-index:0;
    background:
      radial-gradient(ellipse 35% 60% at 30% 100%, rgba(255,201,74,0.55), transparent 70%),
      radial-gradient(ellipse 45% 70% at 55% 100%, rgba(255,122,26,0.55), transparent 70%),
      radial-gradient(ellipse 30% 55% at 75% 100%, rgba(230,53,15,0.5), transparent 70%),
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(122,15,10,0.6), transparent 70%);
    filter:blur(18px);
    animation:flicker 5s ease-in-out infinite alternate;
    mix-blend-mode:screen;
  }
  @keyframes flicker{
    0%{ transform:translateX(-50%) scaleY(1) scaleX(1); opacity:0.85;}
    20%{ transform:translateX(-51%) scaleY(1.06) scaleX(0.98); opacity:1;}
    45%{ transform:translateX(-49%) scaleY(0.96) scaleX(1.03); opacity:0.9;}
    70%{ transform:translateX(-50.5%) scaleY(1.08) scaleX(0.97); opacity:1;}
    100%{ transform:translateX(-50%) scaleY(1) scaleX(1); opacity:0.88;}
  }
  .vignette{
    position:absolute;inset:0;z-index:2;
    background:radial-gradient(ellipse 80% 60% at 50% 50%, transparent 40%, var(--bg) 100%);
    pointer-events:none;
  }

  .hero-content{position:relative;z-index:3;padding:0 6vw;width:100%;box-sizing:border-box;min-width:0;}
  .hero-grid{
    display:grid;grid-template-columns:minmax(0,1fr);
    gap:48px;
    max-width:1180px;margin:0 auto;
    align-items:center;
    text-align:center;
    width:100%;
  }
  .hero-form-wrap{order:1;min-width:0;}
  .hero-copy{order:2;min-width:0;}
  @media(min-width:960px){
    .hero-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,0.95fr);text-align:left;gap:40px;}
  }
  .hero-trust{
    margin-top:26px;
    display:flex;gap:12px;flex-wrap:wrap;
    justify-content:center;
  }
  @media(min-width:960px){ .hero-trust{justify-content:flex-start;} }
  .hero-trust span{
    font-size:0.78rem;font-weight:600;letter-spacing:0.03em;
    padding:8px 14px;border-radius:20px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.16);
    color:var(--text-dim);
    white-space:normal;
    max-width:100%;
  }
  @media(max-width:400px){
    .hero-trust span{font-size:0.72rem;padding:7px 12px;}
  }
  .hero-catalog-link{margin-top:30px;display:inline-flex;}

  .hero-form-card{
    text-align:left;
    background:linear-gradient(165deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
    border:1px solid rgba(255,201,74,0.28);
    border-radius:12px;
    padding:clamp(22px,3vw,34px);
    backdrop-filter:blur(6px);
    box-shadow:0 30px 70px -25px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.03) inset;
  }
  .hero-form-card h2{font-size:clamp(1.4rem,3vw,1.8rem);}
  .hero-form-card > p{margin-top:8px;color:var(--text-dim);font-size:0.92rem;font-weight:300;}
  .hero-form-card .quote-form{margin-top:20px;}
  .hero-form-card .quote-success{margin-top:0;max-width:none;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:10px;
    font-size:0.75rem;letter-spacing:0.25em;text-transform:uppercase;
    color:var(--fire-1);
    margin-bottom:22px;
  }
  .eyebrow::before,.eyebrow::after{content:'';width:24px;height:1px;background:var(--fire-2);opacity:0.6;}

  .hero h1{
    font-size:clamp(2rem, 9.5vw, 6.2rem);
    line-height:1;
    background:linear-gradient(180deg, #fff 0%, var(--fire-1) 45%, var(--fire-2) 75%, var(--fire-3) 100%);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    filter:drop-shadow(0 4px 40px rgba(255,90,20,0.35));
    overflow-wrap:break-word;
  }
  .hero h1 .amp{
    background:linear-gradient(135deg, var(--ring-pink), var(--ring-purple));
    -webkit-background-clip:text;background-clip:text;color:transparent;
    font-size:0.7em;
    padding:0 0.08em;
  }
  .hero-sub{
    margin-top:22px;
    font-size:clamp(1rem,2.2vw,1.3rem);
    color:var(--text-dim);
    font-weight:400;
    max-width:34ch;
    margin-left:auto;margin-right:auto;
  }
  .hero-loc{
    margin-top:14px;
    font-size:0.8rem;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--steel);
  }
  .hero-ctas{
    margin-top:44px;
    display:flex;gap:16px;flex-wrap:wrap;justify-content:center;
  }
  .btn{
    position:relative;
    display:inline-flex;align-items:center;gap:10px;
    padding:16px 30px;
    font-size:0.85rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    border-radius:3px;
    font-weight:600;
    overflow:hidden;
    transition:transform 0.25s ease, box-shadow 0.25s ease;
  }
  .btn .arrow{display:inline-block;transition:transform 0.3s ease;}
  .btn:hover .arrow{transform:translateX(5px);}
  .btn::before{
    content:'';
    position:absolute;top:0;left:-75%;
    width:50%;height:100%;
    background:linear-gradient(120deg, transparent, rgba(255,255,255,0.55), transparent);
    transform:skewX(-20deg);
    transition:left 0.7s ease;
    pointer-events:none;
  }
  .btn:hover::before{left:125%;}
  .btn-primary{
    background:linear-gradient(120deg, var(--fire-1), var(--fire-2) 60%, var(--fire-3));
    background-size:180% 180%;
    color:#1a0a02;
    box-shadow:0 10px 30px -8px rgba(255,110,20,0.6);
    animation:btnGradient 5s ease infinite;
  }
  @keyframes btnGradient{
    0%{background-position:0% 50%;}
    50%{background-position:100% 50%;}
    100%{background-position:0% 50%;}
  }
  .btn-primary:hover{transform:translateY(-3px) scale(1.02);box-shadow:0 16px 38px -6px rgba(255,110,20,0.85);}
  .btn-primary:active{transform:translateY(-1px) scale(0.99);}
  .btn-ghost{
    border:1px solid rgba(245,236,221,0.25);
    color:var(--text);
  }
  .btn-ghost:hover{border-color:var(--fire-2);color:var(--fire-1);transform:translateY(-3px);background:rgba(255,122,26,0.08);}

  .scroll-cue{
    position:absolute;bottom:28px;left:50%;transform:translateX(-50%);
    z-index:3;
    width:22px;height:36px;border:1px solid rgba(245,236,221,0.35);border-radius:12px;
  }
  .scroll-cue::before{
    content:'';position:absolute;top:6px;left:50%;transform:translateX(-50%);
    width:3px;height:8px;border-radius:2px;background:var(--fire-1);
    animation:scrollDot 1.8s ease-in-out infinite;
  }
  @keyframes scrollDot{0%{opacity:1;top:6px;}70%{opacity:0;top:18px;}100%{opacity:0;top:6px;}}

  /* ---------- SECTION SHARED ---------- */
  section{position:relative;padding:120px 6vw;scroll-margin-top:114px;}
  .section-head{max-width:640px;margin-bottom:64px;}
  .section-head .eyebrow{margin-bottom:16px;}
  .section-head h2{font-size:clamp(1.8rem,4vw,3rem);line-height:1.05;}
  .section-head p{margin-top:18px;color:var(--text-dim);font-size:1.05rem;line-height:1.6;font-weight:400;max-width:52ch;}

  /* ---------- ABOUT ---------- */
  .about{
    background:var(--bg-2);
    border-top:1px solid rgba(255,255,255,0.10);
    border-bottom:1px solid rgba(255,255,255,0.10);
  }
  .about-grid{
    display:grid;grid-template-columns:1fr;gap:40px;
  }
  @media(min-width:860px){ .about-grid{grid-template-columns:1.1fr 0.9fr;align-items:center;} }
  .about-copy p{color:var(--text-dim);font-weight:400;line-height:1.75;font-size:1.05rem;margin-bottom:20px;}
  .about-copy strong{color:var(--fire-1);font-weight:600;}
  .stat-row{display:flex;gap:36px;margin-top:36px;flex-wrap:wrap;}
  .stat b{
    display:block;font-family:'Anton',sans-serif;font-size:2.2rem;
    background:linear-gradient(120deg,var(--fire-1),var(--fire-3));
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .stat span{display:block;font-size:0.78rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--steel);margin-top:4px;}

  .ember-frame{
    position:relative;
    aspect-ratio:4/5;
    border-radius:6px;
    background:
      radial-gradient(ellipse at 30% 100%, rgba(255,122,26,0.35), transparent 60%),
      radial-gradient(ellipse at 70% 90%, rgba(224,53,156,0.18), transparent 55%),
      linear-gradient(160deg,#1a120d,#0a0503 70%);
    border:1px solid rgba(255,201,74,0.18);
    box-shadow:0 16px 44px -18px rgba(0,0,0,0.75);
    display:flex;align-items:center;justify-content:center;
    overflow:hidden;
  }
  .ember-frame svg{width:46%;opacity:0.9;}
  .ember-frame video{
    width:100%;height:100%;
    object-fit:cover;
    border-radius:6px;
    filter:saturate(1.18) contrast(1.14) brightness(1.08);
  }

  /* ---------- CATALOG ---------- */
  .catalog{background:var(--bg);}
  .cat-grid{
    display:grid;grid-template-columns:1fr;
    gap:2px;
    background:rgba(255,255,255,0.12);
    scroll-margin-top:114px;
  }
  @media(min-width:640px){ .cat-grid{grid-template-columns:repeat(2,1fr);} }
  @media(min-width:960px){ .cat-grid{grid-template-columns:repeat(3,1fr);} }
  .cat-card{
    background:var(--bg-2);
    aspect-ratio:4/5;
    position:relative;
    display:flex;flex-direction:column;justify-content:flex-end;
    padding:24px;
    overflow:hidden;
    border:1px solid rgba(255,201,74,0.14);
    box-shadow:0 10px 34px -16px rgba(0,0,0,0.75);
  }
  .cat-card.wide{
    aspect-ratio:8/5;
  }
  @media(min-width:960px){ .cat-card.wide{grid-column:span 2;} }
  .cat-card img{
    position:absolute;inset:0;
    width:100%;height:100%;
    object-fit:cover;
    object-position:center;
    z-index:0;
    filter:saturate(1.15) contrast(1.12) brightness(1.08);
    transition:transform 0.6s ease;
  }
  .cat-card:hover img{transform:scale(1.05);}
  .cat-card .glow{
    position:absolute;inset:0;
    background:linear-gradient(to top, rgba(5,3,2,0.85) 0%, rgba(5,3,2,0.42) 34%, rgba(5,3,2,0.02) 62%, transparent 78%);
    z-index:1;
    transition:opacity 0.4s ease;
  }
  .cat-card:hover .glow{opacity:0.85;}
  .cat-card h3{position:relative;font-size:1.1rem;letter-spacing:0.03em;z-index:2;}
  .cat-card .tag{
    position:relative;z-index:2;
    margin-top:8px;
    font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase;
    color:var(--fire-1);
  }

  /* ---------- PROCESS ---------- */
  .process{background:var(--bg-2);border-top:1px solid rgba(255,255,255,0.10);}
  .steps{display:grid;grid-template-columns:1fr;gap:0;}
  @media(min-width:820px){ .steps{grid-template-columns:repeat(4,1fr);} }
  .step{
    padding:32px 26px;
    border-top:1px solid rgba(255,255,255,0.16);
  }
  @media(min-width:820px){
    .step{border-top:none;border-left:1px solid rgba(255,255,255,0.16);}
    .step:first-child{border-left:none;}
  }
  .step .num{
    font-family:'Anton',sans-serif;font-size:0.85rem;color:var(--fire-2);
    letter-spacing:0.1em;
  }
  .step h3{margin-top:14px;font-size:1.15rem;}
  .step p{margin-top:10px;color:var(--text-dim);font-size:0.92rem;font-weight:400;line-height:1.6;}

  /* ---------- INSTALACIÓN REAL (VIDEO) ---------- */
  .install-video{background:var(--bg);}
  .install-grid{
    display:grid;grid-template-columns:1fr;gap:36px;
    align-items:center;
  }
  @media(min-width:860px){ .install-grid{grid-template-columns:1fr 1fr;} }
  .install-video-frame{
    position:relative;
    aspect-ratio:9/12;
    max-width:420px;
    border-radius:8px;
    overflow:hidden;
    border:1px solid rgba(255,201,74,0.18);
    box-shadow:0 20px 50px -20px rgba(0,0,0,0.75);
  }
  .install-video-frame video{
    width:100%;height:100%;object-fit:cover;display:block;
    filter:saturate(1.18) contrast(1.14) brightness(1.08);
  }
  .install-copy h3{font-size:1.3rem;}
  .install-copy p{margin-top:12px;color:var(--text-dim);font-weight:400;line-height:1.7;font-size:1rem;max-width:42ch;}
  .install-copy .btn{margin-top:24px;}

  /* ---------- POR QUÉ ELEGIRNOS ---------- */
  .why-us{background:var(--bg-2);border-top:1px solid rgba(255,255,255,0.10);border-bottom:1px solid rgba(255,255,255,0.10);}
  .why-grid{
    display:grid;grid-template-columns:1fr;gap:28px;
  }
  @media(min-width:640px){ .why-grid{grid-template-columns:repeat(2,1fr);} }
  @media(min-width:1000px){ .why-grid{grid-template-columns:repeat(4,1fr);} }
  .why-card{
    padding:28px 24px;
    border:1px solid rgba(255,255,255,0.16);
    border-radius:6px;
    background:radial-gradient(ellipse 100% 100% at 0% 0%, rgba(255,122,26,0.08), transparent 60%);
    transition:border-color 0.25s ease, transform 0.25s ease;
  }
  .why-card:hover{border-color:rgba(255,122,26,0.35);transform:translateY(-3px);}
  .why-card .why-icon{
    width:42px;height:42px;
    display:flex;align-items:center;justify-content:center;
    border-radius:50%;
    background:linear-gradient(120deg, var(--fire-1), var(--fire-3));
    margin-bottom:16px;
    font-size:1.2rem;
  }
  .why-card h3{font-size:1.02rem;letter-spacing:0.01em;}
  .why-card p{margin-top:8px;color:var(--text-dim);font-size:0.88rem;font-weight:400;line-height:1.55;}

  /* ---------- CONTACT / FOOTER ---------- */
  .contact{
    text-align:center;
    background:
      radial-gradient(ellipse 60% 80% at 50% 120%, rgba(255,90,20,0.28), transparent 60%),
      var(--bg);
  }
  .contact h2{font-size:clamp(2rem,6vw,4rem);}
  .contact p{margin:20px auto 0;color:var(--text-dim);font-weight:400;max-width:44ch;font-size:1.05rem;}
  .contact .hero-ctas{margin-top:40px;}

  /* ---------- FORMULARIO DE PRESUPUESTO ---------- */
  .quote{
    background:var(--bg-2);
    border-top:1px solid rgba(255,255,255,0.10);
    border-bottom:1px solid rgba(255,255,255,0.10);
  }
  .quote-form{
    max-width:720px;
    display:flex;
    flex-direction:column;
    gap:20px;
  }
  .form-row{
    display:grid;
    grid-template-columns:1fr;
    gap:20px;
  }
  @media(min-width:640px){ .form-row{grid-template-columns:1fr 1fr;} }
  .field{display:flex;flex-direction:column;gap:8px;}
  .field label{
    font-size:0.78rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--steel);
  }
  .field label .req{color:var(--fire-2);}
  .field input, .field select, .field textarea{
    padding:14px 16px;
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.15);
    border-radius:3px;
    color:var(--text);
    font-family:'Work Sans',sans-serif;
    font-size:0.95rem;
    transition:border-color 0.25s ease, background 0.25s ease;
  }
  .field input::placeholder, .field textarea::placeholder{color:var(--steel);}
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none;border-color:var(--fire-2);background:rgba(255,255,255,0.07);
  }
  .field select{appearance:none;-webkit-appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='9'><path d='M1 1l6 6 6-6' stroke='%23b8a894' stroke-width='1.6' fill='none'/></svg>");
    background-repeat:no-repeat;background-position:right 16px center;
    padding-right:40px;
  }
  .field select option{background:var(--bg-2);color:var(--text);}
  .field textarea{resize:vertical;min-height:110px;font-family:'Work Sans',sans-serif;}
  .quote-form .btn{align-self:flex-start;margin-top:6px;}
  .form-note{font-size:0.82rem;color:var(--steel);margin-top:-8px;}
  .quote-success{
    max-width:560px;
    padding:32px;
    border:1px solid rgba(255,201,74,0.25);
    border-radius:8px;
    background:radial-gradient(ellipse 80% 100% at 0% 0%, rgba(255,122,26,0.14), transparent 60%);
  }
  .quote-success h3{font-size:1.3rem;}
  .quote-success p{margin-top:10px;color:var(--text-dim);font-weight:400;line-height:1.6;}

  /* ---------- NEWSLETTER ---------- */
  .newsletter{padding:0 6vw 100px;}
  .nl-card{
    max-width:920px;margin:0 auto;
    display:flex;flex-wrap:wrap;gap:32px;
    align-items:center;justify-content:space-between;
    padding:40px clamp(24px,5vw,56px);
    border-radius:10px;
    border:1px solid rgba(255,201,74,0.18);
    background:
      radial-gradient(ellipse 60% 100% at 0% 0%, rgba(255,122,26,0.14), transparent 60%),
      var(--bg-2);
    position:relative;
    overflow:hidden;
  }
  .nl-card::before{
    content:'';position:absolute;inset:0;
    background:linear-gradient(90deg, var(--fire-1), var(--ring-pink), var(--fire-2));
    opacity:0.9;
    height:3px;top:0;left:0;right:0;
  }
  .nl-text{flex:1 1 280px;}
  .nl-text h3{font-size:1.4rem;letter-spacing:0.02em;}
  .nl-text p{margin-top:10px;color:var(--text-dim);font-weight:400;font-size:0.92rem;line-height:1.6;max-width:42ch;}
  .nl-form{
    flex:1 1 320px;
    display:flex;flex-direction:column;gap:14px;
  }
  .nl-form-row{display:flex;gap:10px;flex-wrap:wrap;}
  .nl-form input[type="text"],
  .nl-form input[type="email"]{
    flex:1 1 180px;
    min-width:0;
    padding:15px 18px;
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.15);
    border-radius:3px;
    color:var(--text);
    font-family:'Work Sans',sans-serif;
    font-size:0.92rem;
    transition:border-color 0.25s ease, background 0.25s ease;
  }
  .nl-form input::placeholder{color:var(--steel);}
  .nl-form input[type="text"]:focus,
  .nl-form input[type="email"]:focus{outline:none;border-color:var(--fire-2);background:rgba(255,255,255,0.07);}
  .nl-form .btn{white-space:nowrap;padding:15px 24px;justify-content:center;}
  .nl-status{font-size:0.82rem;color:var(--text-dim);min-height:1.2em;}
  .nl-status.success{color:var(--fire-1);}
  .nl-status.error{color:#ff8a7a;}
  .nl-success{
    flex:1 1 320px;
    padding:20px 24px;
    border:1px solid rgba(255,201,74,0.25);
    border-radius:6px;
    background:rgba(255,122,26,0.08);
  }
  .nl-success h3{font-size:1.15rem;}
  .nl-success p{margin-top:8px;color:var(--text-dim);font-weight:400;font-size:0.9rem;line-height:1.6;}
  @media(max-width:520px){ .nl-form .btn{width:100%;} }

  footer{
    padding:40px 6vw;
    display:flex;flex-wrap:wrap;gap:20px;
    align-items:center;justify-content:space-between;
    border-top:1px solid rgba(255,255,255,0.16);
    font-size:0.8rem;color:var(--steel);
  }
  footer a:hover{color:var(--fire-1);}
  .foot-links{display:flex;flex-wrap:wrap;gap:16px 24px;}

  /* WhatsApp floating button */
  .wa-float{
    position:fixed;bottom:90px;right:24px;z-index:200;
    width:58px;height:58px;border-radius:50%;
    background:linear-gradient(135deg,#25d366,#128c7e);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 8px 24px -6px rgba(37,211,102,0.6);
    animation:pulseWa 2.6s ease-in-out infinite;
  }
  @keyframes pulseWa{
    0%,100%{box-shadow:0 8px 24px -6px rgba(37,211,102,0.6);}
    50%{box-shadow:0 8px 30px -2px rgba(37,211,102,0.9);}
  }
  .wa-float svg{width:28px;height:28px;fill:#fff;}

  /* ---------- MODAL DE BIENVENIDA (DESCUENTO) ---------- */
  .discount-overlay{
    position:fixed;inset:0;z-index:300;
    display:flex;align-items:center;justify-content:center;
    padding:24px;
    background:rgba(4,2,1,0.8);
    backdrop-filter:blur(6px);
    opacity:0;
    pointer-events:none;
    transition:opacity 0.35s ease;
  }
  .discount-overlay.show{
    opacity:1;
    pointer-events:auto;
  }
  .discount-modal{
    position:relative;
    width:100%;max-width:420px;
    max-height:calc(100svh - 48px);
    overflow-y:auto;
    padding:40px 32px 34px;
    text-align:center;
    border-radius:16px;
    background:linear-gradient(165deg, #1a1108, var(--bg-2));
    border:1px solid rgba(255,201,74,0.35);
    box-shadow:0 40px 90px -25px rgba(0,0,0,0.8);
    transform:scale(0.92) translateY(10px);
    transition:transform 0.35s ease;
  }
  .discount-overlay.show .discount-modal{transform:scale(1) translateY(0);}
  .discount-modal .dm-close{
    position:absolute;top:14px;right:14px;
    width:32px;height:32px;
    display:flex;align-items:center;justify-content:center;
    border-radius:50%;
    color:var(--steel);
    font-size:1rem;
    transition:background 0.2s ease, color 0.2s ease;
  }
  .discount-modal .dm-close:hover{background:rgba(255,255,255,0.1);color:var(--text);}
  .discount-modal .dm-icon{
    width:64px;height:64px;margin:0 auto 20px;
    display:flex;align-items:center;justify-content:center;
    border-radius:50%;
    font-size:1.8rem;
    background:linear-gradient(135deg, var(--fire-1), var(--fire-3));
    box-shadow:0 10px 30px -8px rgba(255,122,26,0.6);
  }
  .discount-modal h3{font-size:1.5rem;color:var(--fire-1);}
  .discount-modal p{margin-top:14px;color:var(--text);font-size:1rem;font-weight:300;line-height:1.6;}
  .discount-modal p strong{color:var(--fire-1);}
  .discount-modal .btn{margin-top:26px;width:100%;justify-content:center;}
  @media(max-width:480px){
    .discount-modal{padding:34px 22px 28px;}
  }
</style>

